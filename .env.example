# Resend email delivery: Sending-access key restricted to mail.thearcades.me.
RESEND_API_KEY=
# Separate Full-access key for Contacts, Topics, and Suppressions APIs.
RESEND_CONTACTS_API_KEY=
RESEND_FROM_EMAIL=austen@mail.thearcades.me
# Resend Topic UUID named "Work / AI".
RESEND_TOPIC_WORK_AI_ID=
# Temporary unsubscribe-only key for previously delivered Kit welcome emails.
KIT_LEGACY_UNSUBSCRIBE_API_KEY=
# At least 32 UTF-8 bytes; keep private.
SIGNUP_LINK_SECRET=
# Configure either a complete Upstash pair or a complete Vercel KV pair.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional and default-off; only enables the welcome email after signup.
WORK_WELCOME_ENABLED=false
